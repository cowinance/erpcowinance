# Staging — copiar a `.env` EN EL SERVIDOR y completar. No se versiona.
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml up -d --no-build
#
# Lo que está acá es lo que CAMBIA respecto de un despliegue local. El resto de las variables y su
# explicación completa están en `.env.example`; esto no lo reemplaza.

# ── Dominios y TLS ───────────────────────────────────────────────────────────
# Los dos tienen que resolver a este servidor ANTES de levantar: Caddy valida el dominio al
# arrancar y sin DNS no emite el certificado.
WEB_DOMAIN=staging.cowinance.com
API_DOMAIN=api.staging.cowinance.com
ACME_EMAIL=vos@tu-dominio.com

# ── Puertos: SOLO bucle local ────────────────────────────────────────────────
# El único que habla con internet es Caddy. Sin esto, la API queda publicada en el puerto 3001 sin
# cifrar y el TLS se puede saltear. Ver el encabezado de docker-compose.staging.yml.
API_PORT=127.0.0.1:3001
WEB_PORT=127.0.0.1:3000

# ── Imágenes ya probadas ─────────────────────────────────────────────────────
# El workflow de Release publica cada commit de `main` por SHA después de probar el stack real.
# Se despliega un SHA y no `latest`: así se sabe exactamente qué está corriendo y volver atrás es
# cambiar una línea.
API_IMAGE=ghcr.io/cowinance/erpcowinance/api:PONER_EL_SHA
WEB_IMAGE=ghcr.io/cowinance/erpcowinance/web:PONER_EL_SHA

# ── Secretos ─────────────────────────────────────────────────────────────────
# Distintos de los de producción. Generar con: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# ── Cómo se ven los servicios entre sí y desde afuera ────────────────────────
# El navegador habla con la web; la web habla con la API por la red interna del compose.
API_INTERNAL_URL=http://api:3001/v1
CORS_ORIGINS=https://staging.cowinance.com
# El enlace que sale en los correos de verificación y de reset. Si queda en localhost, el correo
# llega y el enlace no sirve — es el error más difícil de diagnosticar, porque el mail llegó.
APP_BASE_URL=https://staging.cowinance.com

# ── Fotos del animal ─────────────────────────────────────────────────────────
# Con `local` las fotos van al disco del contenedor y SE PIERDEN en cada despliegue. Para probar
# la captura de fotos del móvil hace falta almacenamiento de objetos: Cloudflare R2 tiene capa
# gratuita y habla S3.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ── Correo ───────────────────────────────────────────────────────────────────
# Con `log` el correo se IMPRIME en el log: la verificación de email y el reset no le llegan a
# nadie. Para probar el alta de un usuario de verdad hace falta un SMTP.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cowinance staging <no-reply@tu-dominio.com>

# ── Datos ────────────────────────────────────────────────────────────────────
# `true` siembra la finca de prueba (Hato La Esperanza, 66 animales) y dos cuentas demo. Para un
# staging donde se prueba la app es lo práctico; con datos propios, dejarlo en false.
SEED_DEMO=true
