# Variables del cliente móvil. Expo solo expone al bundle las que empiezan con EXPO_PUBLIC_.
# Copiar a .env.local y ajustar; .env.local no se versiona.

# API del servidor. OJO: en un teléfono "localhost" es el propio teléfono.
# Para probar contra la laptop en la misma red usar su IP de LAN, no localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3001/v1

# Web de Cowinance, para los enlaces que abren el escritorio desde el móvil.
EXPO_PUBLIC_WEB_URL=http://192.168.1.100:3000

# Notificaciones push del cliente. Poner false para desactivarlas.
EXPO_PUBLIC_PUSH_ENABLED=true
