{
  "expo": {
    "name": "Cowinance",
    "slug": "cowinance",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cowinance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.cowinance.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Cowinance se conecta al servidor de la finca en tu red local para sincronizar los datos del hato."
      }
    },
    "android": {
      "package": "com.cowinance.app",
      "adaptiveIcon": {
        "backgroundColor": "#1f4e3d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1f4e3d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0e2a20",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Cowinance usa la cámara para leer la caravana del animal y sacarle fotos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
