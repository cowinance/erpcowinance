{
  "name": "cowinance",
  "private": true,
  "version": "0.1.0",
  "description": "Cowinance — Plataforma ERP para ganadería, agricultura y administración de fincas",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "api": "npm run start:dev --workspace @cowinance/api",
    "web": "npm run dev --workspace @cowinance/web",
    "mobile": "npm run web --prefix apps/mobile",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit:arch": "node scripts/audit-arch.mjs",
    "e2e:web": "npm run build -w @cowinance/api && npm run e2e --workspace @cowinance/web"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "jscpd": "5.0.12",
    "madge": "8.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
